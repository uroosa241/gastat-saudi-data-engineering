{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-gatasat-ksa"
		},
		"ADLjsonapi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgastsaudi12.dfs.core.windows.net/"
		},
		"gatsatapi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.stats.gov.sa"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/gastat_master_pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LKP_GET_PIPELINE_FILTER",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "v_run_status",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "DS_GASTAT_PIPELINE_CONFIG",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FE_EACH_PROCESS",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LKP_GET_PIPELINE_FILTER",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LKP_GET_PIPELINE_FILTER').output.value[0].indicators",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "COPY_GASTAT_TO_BRONZE",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"paginationRules": {
												"supportRFC5988": "true"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "apidataset",
											"type": "DatasetReference",
											"parameters": {
												"p_relative_url": {
													"value": "@concat('/v1/stats/', item().indicator_code)",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "adlsdataset",
											"type": "DatasetReference",
											"parameters": {
												"p_container": {
													"value": "@activity('LKP_GET_PIPELINE_FILTER').output.value[0].storage.container_raw",
													"type": "Expression"
												},
												"p_directory": {
													"value": "@replace(item().raw_path, 'raw/', '')",
													"type": "Expression"
												},
												"p_file_name": {
													"value": "data.json",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "LK_WATERMARK",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [
										{
											"name": "p_container",
											"value": "config"
										},
										{
											"name": "p_directory",
											"value": "watermark"
										},
										{
											"name": "p_file_name",
											"value": "watermark.json"
										}
									],
									"typeProperties": {
										"source": {
											"type": "JsonSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "JsonReadSettings"
											}
										},
										"dataset": {
											"referenceName": "watermarkdataset",
											"type": "DatasetReference",
											"parameters": {}
										},
										"firstRowOnly": false
									}
								}
							]
						}
					},
					{
						"name": "v_run_start_time",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "v_pipeline_name",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_run_start_time",
							"value": {
								"value": "@utcNow()",
								"type": "Expression"
							}
						}
					},
					{
						"name": "v_run_end_time",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "FE_EACH_PROCESS",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "SET_RUN_END_TIME",
							"value": {
								"value": "@utcNow()",
								"type": "Expression"
							}
						}
					},
					{
						"name": "v_run_status",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "v_run_start_time",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_run_status",
							"value": "RUNNING"
						}
					},
					{
						"name": "v_run_id",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_run_id",
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							}
						}
					},
					{
						"name": "v_pipeline_name",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "v_run_id",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_pipeline_name",
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							}
						}
					},
					{
						"name": "SET_STATUS_SUCCESS",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "v_run_end_time",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "SET_STATUS_SUCCESS",
							"value": "SUCCESS"
						}
					},
					{
						"name": "SET_STATUS_FAILED",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "FE_EACH_PROCESS",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "SET_STATUS_FAILED",
							"value": "FAILED"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"v_error_message": {
						"type": "String"
					},
					"v_run_start_time": {
						"type": "String"
					},
					"v_run_status": {
						"type": "String"
					},
					"v_run_id": {
						"type": "String"
					},
					"v_pipeline_name": {
						"type": "String"
					},
					"SET_STATUS_SUCCESS": {
						"type": "String"
					},
					"SET_RUN_END_TIME": {
						"type": "String"
					},
					"v_run_failed": {
						"type": "String"
					},
					"SET_STATUS_FAILED": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-09T06:42:29Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_GASTAT_PIPELINE_CONFIG')]",
				"[concat(variables('factoryId'), '/datasets/apidataset')]",
				"[concat(variables('factoryId'), '/datasets/adlsdataset')]",
				"[concat(variables('factoryId'), '/datasets/watermarkdataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_GASTAT_PIPELINE_CONFIG')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ADLjsonapi",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "pipeline.config.json",
						"folderPath": "pipeline.config.json",
						"fileSystem": "config"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ADLjsonapi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/adlsdataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ADLjsonapi",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_container": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"p_directory": {
						"type": "string",
						"defaultValue": "gastat"
					},
					"p_file_name": {
						"type": "string",
						"defaultValue": "gdp_isic_raw.json"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().p_directory",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().p_container",
							"type": "Expression"
						}
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ADLjsonapi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/apidataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "gatsatapi",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_relative_url": {
						"type": "string",
						"defaultValue": "/v1/stats/DPV_NA_ISIC_EFNA0101"
					}
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "@dataset().p_relative_url",
						"type": "Expression"
					}
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/gatsatapi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/watermarkdataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ADLjsonapi",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "watermark.json",
						"folderPath": "watermark",
						"fileSystem": "config"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ADLjsonapi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ADLjsonapi')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ADLjsonapi_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/gatsatapi')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "RestService",
				"typeProperties": {
					"url": "[parameters('gatsatapi_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		}
	]
}