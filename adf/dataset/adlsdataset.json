{
	"name": "adlsdataset",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLjsonapi",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_container": {
				"type": "string",
				"defaultValue": "bronze"
			},
			"p_directory": {
				"type": "string",
				"defaultValue": "gastat"
			},
			"p_file_name": {
				"type": "string",
				"defaultValue": "gdp_isic_raw.json"
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_file_name",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().p_directory",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().p_container",
					"type": "Expression"
				}
			}
		},
		"schema": {}
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}